{
  "name": "stream-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./scripts/next-server-chunk-resolver.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node -r ./scripts/next-server-chunk-resolver.cjs ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/next-server-chunk-resolver.cjs ./node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2"
  }
}
